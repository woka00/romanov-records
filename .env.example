# PostgreSQL
POSTGRES_USER=romanov
POSTGRES_PASSWORD=changeme
POSTGRES_DB=romanov_records
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=2
DATABASE_MAX_CONNECTION_IDLE=5m
DATABASE_MAX_CONNECTION_LIFETIME=1h

# Backend
HTTP_SHUTDOWN_TIMEOUT=5s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
BACKEND_PORT=8080
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Frontend
FRONTEND_PORT=3000
BACKEND_URL=http://romanov-backend:8080

# На продакшене — публичный URL фронтенда, напр. https://romanovrecords.ru
HTTP_CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telegram bot для уведомлений о новых заявках.
# 1) Создаёшь бота через @BotFather, получаешь токен.
# 2) Каждый администратор пишет /start этому боту, затем смотрит свой chat_id через @userinfobot.
# 3) Список chat_id через запятую (со знаком минус для групповых чатов).
# Если хотя бы одна переменная пустая — уведомления отключены.
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_IDS=

# Optional: Telegram-compatible API relay. Useful with a free Cloudflare Worker
# that forwards /bot... requests to https://api.telegram.org.
# Example: TELEGRAM_API_BASE_URL=https://romanov-telegram-relay.your-name.workers.dev
TELEGRAM_API_BASE_URL=
TELEGRAM_RELAY_SECRET=

# Optional: proxy for outbound backend requests, useful when Telegram API is
# unavailable from the server network. Prefer an HTTPS-capable HTTP proxy.
# Example: HTTPS_PROXY=http://user:password@proxy.example.com:3128
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,romanov-postgres,romanov-backend,romanov-frontend
