# PostgreSQL
POSTGRES_USER=romanov
POSTGRES_PASSWORD=changeme
POSTGRES_DB=romanov_records

# Backend
HTTP_SHUTDOWN_TIMEOUT=5s
BACKEND_PORT=8080
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Frontend
FRONTEND_PORT=3000
BACKEND_URL=http://romanov-backend:8080

# На продакшене — публичный URL бекенда, напр. https://api.romanovrecords.ru/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# На продакшене — публичный URL фронтенда, напр. https://romanovrecords.ru
HTTP_CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telegram bot для уведомлений о новых заявках.
# 1) Создаёшь бота через @BotFather, получаешь токен.
# 2) Каждый администратор пишет /start этому боту, затем смотрит свой chat_id через @userinfobot.
# 3) Список chat_id через запятую (со знаком минус для групповых чатов).
# Если хотя бы одна переменная пустая — уведомления отключены.
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_IDS=
